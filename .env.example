# PostgreSQL connection
DATABASE_URL=postgresql://pagoseguro:pagoseguro@localhost:5432/pagoseguro

# Kaggle credentials (from ~/.kaggle/kaggle.json or env vars)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# AWS / LocalStack
AWS_DEFAULT_REGION=us-east-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566   # remove for real AWS

# ETL row limits (optional — defaults shown)
HIST_PAYSIM_FILAS=50000
HIST_FRAUDTEST_FILAS=20000
