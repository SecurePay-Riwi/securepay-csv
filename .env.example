# AWS. En local va a LocalStack; en AWS, AWS_ENDPOINT_URL no se pone y las
# credenciales salen del rol. LocalStack acepta cualquier credencial.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

DATALAKE_BUCKET=pagoseguro-datalake

# Descarga de los datasets de Kaggle a S3 (uv run python -m securepay_csv.kaggle_datasets)
# Token personal (kaggle.com/settings/api, "Generate New Token").
# Solo en tu .env, nunca en el repo.
KAGGLE_API_TOKEN=
# Carpeta local donde se descargan los CSV (no va a git).
KAGGLE_DOWNLOAD_DIR=data/kaggle
# true: vuelve a descargar aunque el CSV ya esté en la carpeta.
# KAGGLE_FORCE_DOWNLOAD=false

# Extractos de los socios (leen la salida del generador de transacciones)
SEED=42
# file: los deja en generated/extractos/. s3: además en raw/extractos/.
EXT_OUTPUT=file
EXT_MISSING_PCT=2
EXT_EXTRA_PCT=1
EXT_ROUNDING_PCT=3
EXT_RESEND_PCT=10
EXT_BAD_CONTROL_PCT=10
# Si no se define, se busca en generated/ y en ../securepay-generator/generated
# (el repo del generador clonado al lado).
# EXT_INPUT_DIR=
# EXT_OUTPUT_DIR=generated/extractos
